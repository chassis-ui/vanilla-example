{
  "printWidth": 100,
  "arrowParens": "always",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "none",
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "printWidth": 80,
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
